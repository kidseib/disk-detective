<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for the Disk Detective release ZIP.
  The ZIP is the upload root; SignPath signs the declared files inside it.
  version = launcher ProductVersion (for example 1.1.1)
  fileVersion = launcher FileVersion (for example 1.1.1.0)
  Product name, product version, and file version are enforced: signing fails
  if the uploaded launcher does not carry these exact values.
-->
<artifact-configuration xmlns="signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
    <parameter name="fileVersion" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="DiskDetectiveLauncher.exe"
             product-name="Disk Detective"
             product-version="${version}"
             file-version="${fileVersion}">
      <authenticode-sign/>
    </pe-file>

    <powershell-file path="DiskDetective.ps1">
      <authenticode-sign/>
    </powershell-file>
    <powershell-file path="DiskDetective.Core.ps1">
      <authenticode-sign/>
    </powershell-file>
    <powershell-file path="DiskDetective.Tools.ps1">
      <authenticode-sign/>
    </powershell-file>
    <powershell-file path="DiskDetective.Data.ps1">
      <authenticode-sign/>
    </powershell-file>
  </zip-file>
</artifact-configuration>
